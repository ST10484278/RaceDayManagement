@model List<RaceDay.Contracts.EventDto>

@{
    ViewData["Title"] = "Manage Events";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Event Management</h2>
    <a asp-action="CreateEvent" class="btn btn-success">+ New Event</a>
</div>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Title</th>
            <th>Date</th>
            <th>Location</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td><strong>@item.Title</strong></td>
                <td>@item.Date.ToShortDateString()</td>
                <td>@item.Location</td>
                <td>
                    <a asp-action="Categories" asp-route-eventId="@item.Id" class="btn btn-sm btn-info text-white">Categories</a>
                </td>
            </tr>
        }
    </tbody>
</table>
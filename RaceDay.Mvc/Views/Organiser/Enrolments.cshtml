@model List<RaceDay.Contracts.EnrolmentDto>

@{
    ViewData["Title"] = "Event Enrolments";
}

<h2>Enrolments</h2>

<table class="table table-bordered mt-3">
    <thead class="table-dark">
        <tr>
            <th>Enrolment ID</th>
            <th>Participant ID</th>
            <th>Category ID</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>#@item.Id</td>
                <td>@item.UserId</td>
                <td>@item.CategoryId</td>
                <td>
                    @if (item.Status == "Confirmed")
                    {
                        <span class="badge bg-success">Confirmed</span>
                    }
                    else if (item.Status == "Pending")
                    {
                        <span class="badge bg-warning text-dark">Pending</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">@item.Status</span>
                    }
                </td>
                <td>
                    <a asp-action="CaptureResult" asp-route-enrolmentId="@item.Id" class="btn btn-sm btn-outline-primary">Capture Result</a>
                </td>
            </tr>
        }
    </tbody>
</table>
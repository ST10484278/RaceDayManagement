@model IEnumerable<RaceDay.Contracts.EventDto>
@{
    ViewData["Title"] = "Upcoming Events";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold">Upcoming Race Events</h2>
    @if (User.IsInRole("Organiser"))
    {
        <a asp-controller="Organiser" asp-action="CreateEvent" class="btn btn-raceday-accent">+ Host New Event</a>
    }
</div>

<div class="row row-cols-1 row-cols-md-3 g-4">
    @foreach (var evt in Model)
    {
        <div class="col">
            <div class="card card-raceday h-100">
                <img src="/images/default-event.jpg"
                     class="card-img-top card-raceday-img"
                     alt="@evt.Title" />

                <div class="card-body d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <h5 class="card-title fw-bold mb-0">@evt.Title</h5>
                        <span class="status-badge status-confirmed">Active</span>
                    </div>

                    <p class="text-muted small mb-2">📍 @evt.Location | 📅 @evt.Date.ToString("dd MMM yyyy")</p>
                    <p class="card-text text-secondary flex-grow-1">@evt.Description</p>

                    <div class="d-grid gap-2 mt-3">
                        <a asp-controller="Event" asp-action="Details" asp-route-id="@evt.Id" class="btn btn-raceday-primary btn-sm">View Details</a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>